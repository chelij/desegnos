{
  "name": "desegnos",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-only",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "desktop": "node scripts/run.mjs tauri",
    "generate:contract": "node scripts/generate-contract.mjs",
    "release:local": "node scripts/build-release.mjs",
    "test": "node scripts/run.mjs cargo test --workspace",
    "check:rust": "node scripts/run.mjs cargo clippy --workspace --all-targets -- -D warnings",
    "test:canvas-ux": "node tests/canvas-ux-browser.test.mjs",
    "test:ai-models": "node tests/ai-models-browser.test.mjs",
    "test:notices": "node tests/notice-system.test.mjs",
    "test:vault": "node scripts/test-vault.mjs",
    "test:editor": "node scripts/test-editor.mjs",
    "test:smoke": "node tests/native/canvas-smoke.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/language": "6.13.1",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@lezer/highlight": "1.2.5",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-dialog": "2.8.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.3",
    "@types/node": "^26.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
